# ============================================================
#  Atlas — environment configuration (.env.example)
# ============================================================

# ── Server: database & boot ─────────────────────────────────
# Postgres connection string. REQUIRED — the server won't start witho
# Server setting only. The test fixtures never read this: they create and drop
# databases, and read ATLAS_TEST_DATABASE_URL instead.
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas

# Password for the root user seeded on the very first boot. Required only on
# first boot (when no users exist yet); ignored afterwards.
ATLAS_ROOT_PASSWORD=

# Postgres connection pool sizing. The server holds one connection permanently
# for the LISTEN consumer, up to ATLAS_WEBHOOK_MAX_CONCURRENT more for in-flight
# webhook deliveries, plus request/SSE-auth queries. Defaults: max 20, min 1.
ATLAS_DB_MAX_CONNECTIONS=20
ATLAS_DB_MIN_CONNECTIONS=1
# Max seconds to wait for a free pool connection before failing fast (instead of
# hanging) when the pool is saturated. Default: 10
ATLAS_DB_ACQUIRE_TIMEOUT_SECS=10

# ── Server: HTTP & logging ──────────────────────────────────
# HTTP listen port (the server binds 0.0.0.0). Default: 8080
ATLAS_PORT=8080

# tracing/log filter. Default: info,atlas_server=debug,tower_http=info
RUST_LOG=info,atlas_server=debug,tower_http=info

# Public base URL used to build links (e.g. account activation) and reported
# by /health. Optional; empty if unset.
ATLAS_SERVER_URL=http://localhost:8080

# Build identifier reported by /health. Optional.
ATLAS_BUILD=

# ── Server: sessions & cookies ──────────────────────────────
# Session lifetime in hours. Default: 168 (7 days)
ATLAS_SESSION_TTL_HOURS=168
# Absolute max session lifetime in hours. Default: 720 (30 days)
ATLAS_SESSION_MAX_TTL_HOURS=720
# Secure flag on the session cookie. Default: true. Set to "false" (o
# for local HTTP development so the cookie is sent over http://.
ATLAS_COOKIE_SECURE=true

# ── Server: internals ───────────────────────────────────────
# Hash-chain anchor interval. Must be >= 2. Default: 50
ATLAS_ANCHOR_INTERVAL=50

# Upper bound (seconds) on the graceful drain after a shutdown signal (SIGINT or,
# on Unix, SIGTERM). Long-lived SSE streams that do not disconnect within this
# window are dropped so the process can terminate. Default: 20
ATLAS_SHUTDOWN_TIMEOUT_SECS=20

# ── Server: semantic search embeddings ──────────────────────
# Disabled by default. When disabled, semantic search returns 503 and should not
# be advertised by capability-aware clients.
ATLAS_EMBEDDINGS_ENABLED=false
# "deterministic" is intended for offline development/tests. Use
# "openai_compatible" with a project-scoped service-account key in production.
ATLAS_EMBEDDINGS_PROVIDER=deterministic
ATLAS_EMBEDDINGS_MODEL=atlas-test-embedding
# Must match both the provider output and the pgvector schema. Default: 1536
ATLAS_EMBEDDINGS_DIMENSIONS=1536
# Required only for enabled openai_compatible embeddings. Never commit a value.
ATLAS_EMBEDDINGS_API_KEY=
ATLAS_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
ATLAS_EMBEDDINGS_BATCH_SIZE=64
ATLAS_EMBEDDINGS_TIMEOUT_MS=30000
ATLAS_EMBEDDINGS_RETRY_ATTEMPTS=2

# ── Server: rate limiting ───────────────────────────────────
# Per-authenticated-principal limits. Defaults: enabled, 20 requests/s, burst 40.
ATLAS_RATE_LIMIT_ENABLED=true
ATLAS_RATE_LIMIT_PER_SECOND=20
ATLAS_RATE_LIMIT_BURST=40

# ── Server: webhooks ────────────────────────────────────────
# openssl rand -base64 32. Required; never commit a generated value.
ATLAS_WEBHOOK_ENC_KEY=
# Keep private targets disabled unless the deployment explicitly needs them;
# enabling them weakens the default SSRF protection.
ATLAS_ALLOW_PRIVATE_WEBHOOK_TARGETS=false
ATLAS_WEBHOOK_POLL_INTERVAL_MS=1000
ATLAS_WEBHOOK_MAX_ATTEMPTS=5
ATLAS_WEBHOOK_DELIVERY_TIMEOUT_MS=10000
ATLAS_WEBHOOK_MAX_CONCURRENT=16
ATLAS_WEBHOOK_BATCH_SIZE=32
ATLAS_WEBHOOK_LEASE_SECS=30

# ── Server: attachments storage ─────────────────────────────
# Which backend stores uploaded files: "disk" (default) or "s3" (S3-c
# e.g. Cloudflare R2).
ATLAS_ATTACHMENT_BACKEND=disk

# disk backend: content-addressed root directory. Default: ./data/att
ATLAS_ATTACHMENT_ROOT=./data/attachments

# Comma-separated allow-list of upload file extensions (e.g.
# "png,jpg,jpeg,gif,webp,pdf,docx,xlsx,txt,md,csv"). Each entry is trimmed, a
# single leading "." is stripped, and it is lowercased. When set, an upload's
# declared extension must be in this list AND pass the content check. When empty
# or unset, the default applies (all safe types allowed; executables/scripts
# always blocked by the built-in blocklist and content check).
ATLAS_UPLOAD_ALLOWED_EXTENSIONS=

# s3 backend (only when ATLAS_ATTACHMENT_BACKEND=s3). The first four
# in that case; startup fails naming any missing one (without echoing
ATLAS_S3_BUCKET=atlas-attachments
ATLAS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ATLAS_S3_ACCESS_KEY_ID=
ATLAS_S3_SECRET_ACCESS_KEY=
# Optional; R2 uses "auto" (default). Real AWS S3 wants a concrete re
ATLAS_S3_REGION=auto

# ============================================================
#  Agent tools (atlas_mcp / atlas_cli) — only if you run them
# ============================================================
# Atlas server URL these tools talk to. Default: http://localhost:808
ATLAS_BASE_URL=http://localhost:8080
# Bearer token (atlas_...). Required for the stdio MCP server and as
# token fallback. Keep it out of source control.
ATLAS_TOKEN=

# MCP HTTP transport (only when running the MCP server in http mode)
ATLAS_MCP_TRANSPORT=stdio      # stdio (default) | http
ATLAS_MCP_BIND=127.0.0.1       # http mode bind address
ATLAS_MCP_PORT=3001            # http mode port

# ============================================================
#  Tests and build-time settings
# ============================================================
# Integration tests create and force-drop databases derived from this URL. It
# must identify disposable Postgres on loopback unless the explicit remote opt-in
# is set. The `tests` script normally supplies an ephemeral URL automatically.
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_dev
ATLAS_TEST_ALLOW_REMOTE_DB=0
# The Nix dev shell normally supplies this rootless Podman socket automatically.
DOCKER_HOST=unix:///run/user/<uid>/podman/podman.sock

# Optional desktop/frontend build settings.
ATLAS_DESKTOP_ORIGIN=https://atlas.example.com
ATLAS_DESKTOP_GATE_EVIDENCE_PATH=/tmp/atlas-desktop-gate-evidence.json
VITE_ATLAS_DESKTOP_GATE=0
# Empty falls back to GITHUB_SHA, local Git, then "unknown".
VITE_ATLAS_BUILD_COMMIT=

# ============================================================
#  Deployment helpers — only when using scripts under deploy/
# ============================================================
ATLAS_DEPLOY_HOST=user@203.0.113.5
ATLAS_DEPLOY_TAG=latest
ATLAS_BACKEND_UPSTREAM=<backend-host>:8080
ATLAS_MCP_UPSTREAM=<mcp-host>:3001

;;
(create)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--kind=[Reference kind\: \`relates\`, \`blocks\`, \`parent\`, or \`spec\`]:KIND:_default' \
'--target=[Target\: a task readable ID (e.g. \`ATL-10\`) or a document UUID. UUIDs are resolved as document targets; anything else is treated as a task readable ID]:TARGET:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \

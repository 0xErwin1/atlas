#compdef atlas

autoload -U is-at-least

_atlas() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--workspace=[Default workspace slug used when \`--workspace\` is not given per-command]:WORKSPACE:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
":: :_atlas_commands" \
"*::: :->atlas" \
&& ret=0
    case $state in
    (atlas)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:atlas-command-$line[1]:"
        case $line[1] in
            (version)
_arguments "${_arguments_options[@]}" : \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--workspace=[Default workspace slug used when \`--workspace\` is not given per-command]:WORKSPACE:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(search)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug to search in]:WORKSPACE:_default' \
'--type=[Filter results by kind\: \`all\` (default), \`note\`, or \`task\`]:TYPE:_default' \
'--sort=[Sort order\: \`relevance\` (default) or \`updated\`]:SORT:_default' \
'--limit=[Maximum number of results (clamped to 1..=200)]:LIMIT:_default' \
'--cursor=[Pagination cursor returned by a previous search]:CURSOR:_default' \
'--mode=[Retrieval mode\: \`lexical\` (default), \`semantic\`, or \`hybrid\`]:MODE:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
':query -- Query string (required). Supports token filters such as `status\:open`, `tag\:rust`, `project\:atlas`:_default' \
&& ret=0
;;
(tasks)
_arguments "${_arguments_options[@]}" : \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--workspace=[Default workspace slug used when \`--workspace\` is not given per-command]:WORKSPACE:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_atlas__subcmd__tasks_commands" \
"*::: :->tasks" \
&& ret=0

    case $state in
    (tasks)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:atlas-tasks-command-$line[1]:"
        case $line[1] in
            (list)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--board=[Scope to a specific board (name or UUID); omit for workspace-wide results]:BOARD:_default' \
'--status=[Filter to tasks in this column/status name]:STATUS:_default' \
'--assignee=[Filter to tasks assigned to this actor (\`me\`, \`user\:{uuid}\`, \`api_key\:{uuid}\`)]:ASSIGNEE:_default' \
'*--priority=[Filter to tasks with this priority (repeatable)]:PRIORITIES:_default' \
'*--label=[Filter to tasks carrying this label (repeatable)]:LABELS:_default' \
'--sort=[Sort key (e.g. \`updated_at_desc\`)]:SORT:_default' \
'--limit=[Maximum results to return (clamped to 1..=200; default 20)]:LIMIT:_default' \
'--cursor=[Pagination cursor returned by a previous list]:CURSOR:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(get)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--detail=[Level of detail\: \`compact\` (default) or \`full\` (adds description, references, subtasks, and assignees)]:DETAIL:(compact full)' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
':readable_id -- Task readable ID, e.g. `ATL-42`:_default' \
&& ret=0
;;
(create)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--title=[Task title (required in single-item mode; ignored when --stdin is set)]:TITLE:_default' \
'--board=[Board name or UUID (required in single-item mode; ignored when --stdin is set)]:BOARD:_default' \
'--column=[Column name on the board (required in single-item mode; ignored when --stdin is set; resolved by case-insensitive substring)]:COLUMN:_default' \
'--description=[Task description (markdown)]:DESCRIPTION:_default' \
'--priority=[Priority\: \`low\`, \`medium\`, \`high\`, or \`urgent\`]:PRIORITY:_default' \
'*--label=[Label to attach (repeatable)]:LABELS:_default' \
'--estimate=[Work estimate (non-negative story-point integer)]:ESTIMATE:_default' \
'--due-date=[Due date (ISO 8601, e.g. \`2026-01-31T00\:00\:00Z\`)]:DUE_DATE:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--stdin[Read one JSON object per line from stdin; each line becomes a separate create call. When set, \`--board\`, \`--column\`, and \`--title\` are ignored]' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(update)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--title=[New title]:TITLE:_default' \
'--description=[New description (markdown)]:DESCRIPTION:_default' \
'--priority=[New priority\: \`low\`, \`medium\`, \`high\`, or \`urgent\`]:PRIORITY:_default' \
'*--label=[Replace the full label set (repeatable; omit to leave labels unchanged)]:LABELS:_default' \
'--estimate=[New estimate (non-negative story-point integer)]:ESTIMATE:_default' \
'--due-date=[New due date (ISO 8601)]:DUE_DATE:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--clear-priority[Clear the priority field (set to null)]' \
'--clear-due-date[Clear the due-date field (set to null)]' \
'--clear-estimate[Clear the estimate field (set to null)]' \
'--stdin[Read one JSON object per line from stdin; each line becomes a separate update call. When set, the positional \`readable_id\` argument is ignored]' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
'::readable_id -- Task readable ID, e.g. `ATL-42` (required in single-item mode; ignored when --stdin is set):_default' \
&& ret=0
;;
(move)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--column=[Target column name (required; resolved on the board the task belongs to)]:COLUMN:_default' \
'--board=[Board name or UUID (optional; defaults to the task'\''s own board)]:BOARD:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
':readable_id -- Task readable ID, e.g. `ATL-42`:_default' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--workspace=[Workspace slug]:WORKSPACE:_default' \
'--base-url=[Override the Atlas server URL]:BASE_URL:_default' \
'--token=[Bearer token for authentication]:TOKEN:_default' \
'--confirm[Confirm the deletion. Required — prevents accidental non-reversible deletes]' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
':readable_id -- Task readable ID, e.g. `ATL-42`:_default' \
&& ret=0
;;

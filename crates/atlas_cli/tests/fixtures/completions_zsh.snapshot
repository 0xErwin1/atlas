(( $+functions[_atlas__subcmd__help_commands] )) ||
_atlas__subcmd__help_commands() {
    local commands; commands=(
'version:Print the version of the CLI binary' \
'search:Search across documents and tasks in a workspace' \
'tasks:Manage tasks (create, list, get, update, move, delete)' \
'trash:Manage recoverable resources in the root/system-admin human Trash' \
'docs:Manage documents (list, get, create, update-metadata, update-content, delete)' \
'workspaces:Inspect workspaces (list, get)' \
'projects:Inspect projects (list, get)' \
'boards:Inspect boards (list)' \
'columns:Inspect columns on a board (list)' \
'tags:Inspect workspace tags (list)' \
'members:Inspect workspace members (list)' \
'folders:Inspect folders (list, get)' \
'activity:List workspace-level activity (audit log)' \
'users:Manage system users (admin; list, create, disable, enable, reset-password, regenerate-link, memberships)' \
'api-keys:Manage personal API keys (list, create, revoke, set-global, grants, delete-grant)' \
'groups:Manage workspace groups (list, create, delete, add-member, remove-member, members)' \
'status-templates:Manage workspace status templates (list, create, update, delete, apply)' \
'platform-status-templates:Manage the Atlas-wide default statuses new workspaces are seeded from (admin; list, create, update, delete)' \
'saved-searches:Manage workspace saved searches (list, create, rename, delete)' \
'task-views:Manage workspace task views (list, get, create, update, delete)' \
'property-definitions:Manage workspace property definitions / custom fields (list, create, delete)' \
'grants:Manage workspace and project permission grants (workspace/project list, create, revoke)' \
'audit:Query security audit logs (workspace, platform)' \
'completions:Generate shell completion scripts for the \`atlas\` binary' \
'config:Manage CLI configuration (path, show, set-url, set-token, clear-token)' \
'import:Import content from an external source (e.g. an Obsidian vault)' \
'export:Export an Atlas project to an external format (e.g. an Obsidian vault)' \
'doctor:Runs every present component'\''s server-side doctor check and renders the findings. The HTTP call always succeeds with 200; this command'\''s own exit code is 1 when any finding is \`Critical\`, 0 otherwise' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'atlas help commands' commands "$@"
}

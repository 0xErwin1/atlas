'--workspace=[Default workspace slug used when \`--workspace\` is not given per-command]:WORKSPACE:_default' \
'--json[Emit JSON output (implied when stdout is not a TTY)]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_atlas__subcmd__tasks__subcmd__refs_commands" \

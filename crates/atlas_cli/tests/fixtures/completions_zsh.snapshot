_atlas__subcmd__api-keys_commands() {
    local commands; commands=(
'list:List API keys for the current user' \
'create:Create a new API key (the secret is shown exactly once)' \
'revoke:Revoke an API key permanently (requires --confirm)' \
'set-global:Toggle a key'\''s global workspace reach' \
'set-scopes:Replace the full capability scope set for a key' \
'grants:List grants associated with an API key' \
'delete-grant:Delete a specific grant from an API key (requires --confirm)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'atlas api-keys commands' commands "$@"
}
